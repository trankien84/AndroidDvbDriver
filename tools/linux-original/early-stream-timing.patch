diff --git a/tbs5530.c b/tbs5530.c
--- a/tbs5530.c
+++ b/tbs5530.c
@@ -165,7 +165,8 @@ static int tbs5530_start_streaming_core(struct tbs5530_dev *dev)
 
 	buf[0] = 10;
 	buf[1] = dev->active_fe;
-	tbs5530_op_rw(dev->udev, 0x8a, 0, 0, buf, 2, tbs5530_WRITE_MSG);
+	if (!early_stream_select)
+		tbs5530_op_rw(dev->udev, 0x8a, 0, 0, buf, 2, tbs5530_WRITE_MSG);
 
 	dev->streaming = true;
 	dev->urb_complete_ok = 0;
@@ -264,6 +265,11 @@ static int tbs5530_fe_ter_init(struct dvb_frontend *fe)
 	struct tbs5530_dev *dev = fe->dvb->priv;
 
 	dev->active_fe = 0;
+	if (early_stream_select) {
+		u8 data[2] = {10, 0};
+		int ret = tbs5530_op_rw(dev->udev, 0x8a, 0, 0, data, 2, tbs5530_WRITE_MSG);
+		if (ret != 2) return ret < 0 ? ret : -EREMOTEIO;
+	}
 	if (dev->fe_ter_ops_orig.init)
 		return dev->fe_ter_ops_orig.init(fe);
 	return 0;
