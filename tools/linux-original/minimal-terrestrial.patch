+static int tbs5530_start_streaming(struct tbs5530_dev *dev)
+{
+	int ret;
+	mutex_lock(&dev->min_stream_lock);
+	ret = tbs_m_gate(dev);
+	if (!ret && !dev->streaming) {
+		if (dev->min_started) ret = tbs_m_fail(dev, -EPERM);
+		else { dev->min_started = true; dev->min_receive = tbs_m_now(); }
+	}
+	if (!ret) ret = tbs5530_start_streaming_core(dev);
+	mutex_unlock(&dev->min_stream_lock);
+	return ret;
