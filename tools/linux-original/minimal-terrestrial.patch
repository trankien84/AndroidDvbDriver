+static void tbs5530_stop_streaming(struct tbs5530_dev *dev)
+{
+	mutex_lock(&dev->min_stream_lock);
+	tbs5530_stop_streaming_core(dev);
+	dev_info(&dev->udev->dev, "M drained: submitted=%d reaped=%d outstanding=%d bytes=%lld fault=%d\n",
