<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false"
        tools:replace="android:required" />
    <application>
        <activity
            android:name="info.martinmarinov.dvbdriver.Tbs5530ReloadInitActivity"
            android:label="TBS5530 — Khởi tạo reload store, không tuner"
            android:exported="true" />
        <activity
            android:name="info.martinmarinov.dvbdriver.Tbs5530HistoryRecoveryActivity"
            android:label="TBS5530 — Recovery lịch sử, không tuner"
            android:exported="true" />
        <activity
            android:name="info.martinmarinov.dvbdriver.Tbs5530AutonomousDiagnosticActivity"
            android:label="DVB-T Driver — TBS5530 Debug"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/tbs5530_autonomous_device_filter" />
        </activity>
        <activity
            android:name="info.martinmarinov.dvbdriver.Tbs5530PermissionPreflightActivity"
            android:exported="true" />
        <activity
            android:name="info.martinmarinov.dvbdriver.Tbs5530UsbDiagnosticActivity"
            android:exported="true" />
        <activity
            android:name="info.martinmarinov.dvbdriver.Tbs5530OperationalDiagnosticActivity"
            android:exported="true" />
    </application>
</manifest>
